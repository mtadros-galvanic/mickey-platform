#!/bin/sh
set -eu

preferred_toolchain="${MICKEY_CHROME_DEVTOOLS_TOOLCHAIN:-{{ mickey_codex_chrome_devtools_mcp_toolchain_path }}}"
installed_bin={{ (mickey_codex_chrome_devtools_mcp_install_dir ~ '/node_modules/.bin/chrome-devtools-mcp') | quote }}

if [ ! -x "$installed_bin" ]; then
  echo "the managed chrome-devtools-mcp {{ mickey_codex_chrome_devtools_mcp_version }} installation is missing" >&2
  exit 1
fi

if [ -x "$preferred_toolchain" ]; then
  exec "$preferred_toolchain" "$installed_bin" "$@"
fi

for bin_dir in "$HOME/.local/bin" /usr/local/bin /usr/bin; do
  node_bin="$bin_dir/node"

  if [ ! -x "$node_bin" ]; then
    continue
  fi

  node_major="$("$node_bin" -p 'process.versions.node.split(".")[0]' 2>/dev/null || printf '0')"
  case "$node_major" in
    ''|*[!0-9]*) node_major=0 ;;
  esac

  if [ "$node_major" -ge 20 ]; then
    PATH="$bin_dir:$PATH" exec "$installed_bin" "$@"
  fi
done

echo "chrome-devtools-mcp requires Node 20 or newer; no suitable runtime was found" >&2
exit 1
