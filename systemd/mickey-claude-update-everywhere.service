[Unit]
Description=Update Claude Code across Mickey Linux hosts
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=galvanic
WorkingDirectory=/home/galvanic/Projects/mickey/mickey-platform
Environment=PATH=/home/galvanic/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=UPDATE_ATTEMPTS=3
TimeoutStartSec=45min
Nice=10
ExecStart=/home/galvanic/Projects/mickey/mickey-platform/scripts/update-claude-everywhere.sh
